# udev rules: stable device names for the vehicle Pi.
#   sudo cp scripts/99-auv.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# Pixhawk 2.4.8 running ArduSub enumerates as 1209:5741 (confirmed with lsusb).
# Fallback: fcu_url:=/dev/serial/by-id/usb-ArduPilot_Pixhawk1_<serial>-if00:115200
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="5741", SYMLINK+="pixhawk", MODE="0666"
