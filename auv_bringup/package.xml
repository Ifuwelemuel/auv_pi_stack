<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auv_bringup</name>
  <version>2.0.0</version>
  <description>Launch files and configuration for the Pi-based AUV.</description>
  <maintainer email="lemuelossaiifuwe@gmail.com">Lemuel Ossai Ifuwe</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>auv_control</exec_depend>
  <exec_depend>auv_drivers</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>ros2bag</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
